{
  "name": "{{commandName}}",
  "description": "Adds an assignment to a group.",
  "parameters": {
    "type": "object",
    "properties": {
      "groupe": {
        "type": "string",
        "description": "Group name."
      },
      "devoir": {
        "type": "string",
        "description": "Assignment title."
      },
      "matiere": {
        "type": "string",
        "description": "Subject."
      },
      "date": {
        "type": "string",
        "description": "Due date in DD-MM-YYYY format.",
        "pattern": "^(0[1-9]|[12][0-9]|3[01])-(0[1-9]|1[0-2])-[0-9]{4}$"
      }
    },
    "required": ["groupe", "devoir", "matiere", "date"]
  }
}
