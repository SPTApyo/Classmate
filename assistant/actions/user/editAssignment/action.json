{
  "name": "{{commandName}}",
  "description": "Updates an existing assignment in a group.",
  "parameters": {
    "type": "object",
    "properties": {
      "id": {
        "type": "number",
        "description": "Assignment ID."
      },
      "group": {
        "type": "string",
        "description": "Group name."
      },
      "newTitle": {
        "type": "string",
        "description": "New title."
      },
      "newSubject": {
        "type": "string",
        "description": "New subject."
      },
      "newDate": {
        "type": "string",
        "description": "New due date in YYYY-MM-DD format.",
        "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$"
      }
    },
    "required": ["id", "group"]
  }
}
